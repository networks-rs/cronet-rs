# The pinned Rust core uses f16 conversion helpers. Cronet target toolchains
# omit compiler-rt builtins globally, so restore them for this target-toolchain
# generator without changing Chromium's compiler defaults.
executable("root_store_tool") {
  sources = [ "root_store_tool.cc" ]
  deps = [
    "//base",
    "//crypto",
    "//net/cert:root_store_proto_full",
    "//third_party/boringssl",
  ]
  configs += [ "//build/config/clang:compiler_builtins" ]
}
